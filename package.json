{
  "name": "max-chess-3d-space",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "db:check": "python3 scripts/schema.py && python3 scripts/check-native-upgrade.py",
    "db:migrate:local": "wrangler d1 migrations apply planetary_max_root_db --local",
    "db:migrate": "wrangler d1 migrations apply planetary_max_root_db --remote",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:native": "node scripts/native-settlement-smoke.mjs",
    "test:sovereign": "node scripts/sovereign-smoke.mjs"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.172.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "wrangler": "^4.0.0"
  }
}
